---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Contact Jonathan Muir — resume, email, LinkedIn, GitHub.">
  <section class="container page-head">
    <h1>Contact</h1>
    <p class="lede">
      [Placeholder] Open to staff/lead design-technologist conversations.
      The fastest routes:
    </p>
  </section>

  <section class="container actions">
    <!-- PLACEHOLDER: confirm public email + whether a contact form is wanted (open question in brief) -->
    <a class="action" href="mailto:hello@example.com">
      <span class="eyebrow">Email</span>
      <span class="action-value">hello@example.com</span>
    </a>
    <a class="action" href="https://www.linkedin.com/in/jonathannmuir/">
      <span class="eyebrow">LinkedIn</span>
      <span class="action-value">in/jonathannmuir</span>
    </a>
    <!-- PLACEHOLDER: resume PDF added in Phase 2/3 -->
    <a class="action" href="#" aria-disabled="true">
      <span class="eyebrow">Resume</span>
      <span class="action-value">Download PDF (coming with Phase 2 content)</span>
    </a>
    <a class="action" href="https://github.com/jonathanmuir-flc">
      <span class="eyebrow">GitHub</span>
      <span class="action-value">jonathanmuir-flc</span>
    </a>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-8);
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .lede {
    font-size: var(--text-md);
    color: var(--color-ink-secondary);
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .action {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color var(--duration-quick) var(--ease-out);
  }

  .action:hover {
    border-color: var(--color-accent);
  }

  .action-value {
    font-weight: 600;
  }
</style>
