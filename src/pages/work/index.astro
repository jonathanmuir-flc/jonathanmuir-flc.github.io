---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import { TAG_LABELS } from "../../lib/tags";

const entries = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Work"
  description="Case studies in product design, design systems, and motion — enterprise and startup."
>
  <section class="container page-head">
    <h1>Work</h1>
    <p>
      [Placeholder] Case studies across product design, design systems, and
      motion — each one framed around the problem, the system applied, and the
      outcome.
    </p>
  </section>

  <section class="container">
    <div class="filters" role="group" aria-label="Filter case studies by discipline">
      <button class="filter is-active" data-filter="all" aria-pressed="true">All</button>
      {
        Object.entries(TAG_LABELS).map(([value, label]) => (
          <button class="filter" data-filter={value} aria-pressed="false">
            {label}
          </button>
        ))
      }
    </div>

    <div class="card-grid" id="work-grid">
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: all entries render statically; this only
  // toggles visibility. No framework runtime shipped.
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const cards = document.querySelectorAll<HTMLElement>("#work-grid [data-tags]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => {
        b.classList.toggle("is-active", b === button);
        b.setAttribute("aria-pressed", String(b === button));
      });
      cards.forEach((card) => {
        const tags = card.dataset.tags?.split(" ") ?? [];
        card.hidden = filter !== "all" && !tags.includes(filter ?? "");
      });
    });
  });
</script>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-8);
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .page-head p {
    color: var(--color-ink-secondary);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .filter {
    font: inherit;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-secondary);
    cursor: pointer;
    transition: all var(--duration-quick) var(--ease-out);
  }

  .filter:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter.is-active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
    padding-bottom: var(--space-16);
  }
</style>
