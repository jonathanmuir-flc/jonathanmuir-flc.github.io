---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/paths";
import { TAG_LABELS } from "../lib/tags";

interface Props {
  entry: CollectionEntry<"caseStudies">;
}

const { entry } = Astro.props;
const { title, client, summary, tags, nda } = entry.data;
---

<article class="card" data-tags={tags.join(" ")}>
  <div class="card-media" aria-hidden="true">
    <span class="card-media-note">Visual — Phase 3</span>
  </div>
  <div class="card-body">
    <p class="eyebrow">{client}{nda && <span class="nda-badge">NDA-reviewed</span>}</p>
    <h3><a href={withBase(`/work/${entry.id}`)}>{title}</a></h3>
    <p class="card-summary">{summary}</p>
    <ul class="card-tags">
      {tags.map((tag) => <li>{TAG_LABELS[tag]}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--duration-base) var(--ease-out),
      translate var(--duration-base) var(--ease-out);
  }

  .card:hover {
    box-shadow: var(--shadow-card);
    translate: 0 -2px;
  }

  .card-media {
    aspect-ratio: 16 / 9;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-surface-sunken),
      var(--color-surface-sunken) 12px,
      var(--color-surface) 12px,
      var(--color-surface) 24px
    );
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  .card-media-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    background: var(--color-surface);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--color-border);
  }

  .card-body {
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .nda-badge {
    margin-left: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
  }

  h3 {
    font-size: var(--text-md);
  }

  h3 a {
    text-decoration: none;
  }

  /* Stretch the primary link over the whole card. */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card {
    position: relative;
  }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .card-tags li {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
</style>
