---
import { withBase } from "../lib/paths";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-cta">
      <p class="eyebrow">Get in touch</p>
      <!-- PLACEHOLDER: confirm public contact email for the new site -->
      <a class="footer-email" href="mailto:hello@example.com">hello@example.com</a>
    </div>
    <ul class="footer-links">
      <li><a href="https://www.linkedin.com/in/jonathannmuir/">LinkedIn</a></li>
      <li><a href="https://github.com/jonathanmuir-flc">GitHub</a></li>
      <li><a href={withBase("/contact")}>Resume</a></li>
    </ul>
    <p class="footer-meta">
      © {year} Jonathan Muir · Designed as a system, built with an AI-assisted
      workflow. <a href={withBase("/styleguide")}>View the design tokens</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12);
  }

  .footer-email {
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .footer-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
</style>
